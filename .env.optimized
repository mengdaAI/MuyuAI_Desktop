# Optimized Environment Variables for Windows
# This configuration balances performance and functionality

# API Configuration
MUYU_API_DOMAIN=https://resume-api.muyulab.com
MUYU_WEB_URL=https://resume.muyulab.com
STT_BACKEND_ENDPOINT=wss://resume-api.muyulab.com/api/v1/stt/stream

# Window Settings - Performance Optimized
# Content Protection: Set to false for better performance, true for security
MUYU_CONTENT_PROTECTION=false

# Always on Top: Set to true for better UX, may slightly affect performance
MUYU_ALWAYS_ON_TOP=true

# Additional Performance Notes:
# 1. webSecurity: false is currently enabled in windowManager.js
#    Consider enabling it for production: webSecurity: true
#
# 2. backgroundThrottling: false is currently enabled
#    Consider enabling it: backgroundThrottling: true
#
# 3. transparent: true affects Windows performance
#    Consider using opaque windows for better performance
#
# 4. setContentProtection(true) uses GPU encryption
#    Set MUYU_CONTENT_PROTECTION=false to disable
