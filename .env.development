# Development Environment Configuration
# This file fixes Electron security warnings in development mode

# Security Warnings Explanation:
# 
# 1. webSecurity: false - Allows loading insecure HTTP content
# 2. allowRunningInsecureContent: true - Allows mixed content (HTTP + HTTPS)
# 3. Content-Security-Policy - Missing CSP header
#
# These are disabled in development for easier development but should be enabled in production.

# To fix these warnings, you need to modify:
# src/window/windowManager.js
#
# Change:
#   webSecurity: false
# To:
#   webSecurity: true
#
# Change:
#   backgroundThrottling: false
# To:
#   backgroundThrottling: true
#
# Note: Enabling webSecurity may break some features that rely on loading local files
# or insecure content. Test thoroughly before enabling.

# API Configuration
MUYU_API_DOMAIN=https://resume-api.muyulab.com
MUYU_WEB_URL=https://resume.muyulab.com
STT_BACKEND_ENDPOINT=wss://resume-api.muyulab.com/api/v1/stt/stream

# Window Settings
MUYU_CONTENT_PROTECTION=true
MUYU_ALWAYS_ON_TOP=true
